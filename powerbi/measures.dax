// =========================================================================
// Measures - branch-network-strategy
// =========================================================================
// GENERATED by scripts/14_generate_pbip.py. Do not edit: the model and
// this file are rendered from one list, so they cannot disagree.
//
// Written to be read. Every measure that could be computed more than one
// way says which way it computes and why, because the definitional
// choices in this project are the analysis, not an implementation detail.
// =========================================================================


// -------------------------------------------------------------------------
// Deposits, share and trend   [table: fact_branch_deposits]
// -------------------------------------------------------------------------

Total Deposits =
SUM ( fact_branch_deposits[deposits] )

// Deposits are stored in WHOLE DOLLARS. SOD publishes thousands and the
// conversion happens once, in script 10. A second conversion here would
// be invisible and would surface as a 1000x error only where somebody
// compared two visuals.
Total Deposits ($bn) =
DIVIDE ( [Total Deposits], 1000000000 )

Branch Count =
DISTINCTCOUNT ( fact_branch_deposits[uninumbr] )

Subject Deposits =
CALCULATE ( [Total Deposits], dim_institution[is_subject_bank] = TRUE )

// REMOVEFILTERS on the institution ONLY, leaving geography and time
// intact. ALL() over the model would compare a county's subject deposits
// against the whole footprint; no removal at all returns 100%. Both look
// entirely plausible on a card, which is what makes this the classic
// filter-context error.
Market Deposits =
CALCULATE ( [Total Deposits], REMOVEFILTERS ( dim_institution ) )

Market Share % =
DIVIDE ( [Subject Deposits], [Market Deposits] ) * 100

// DATEADD needs a REAL date column on a table marked as a date table.
// Against an integer year it does not error - it returns blank, and the
// measure reads as no change.
Deposits PY =
CALCULATE ( [Total Deposits], DATEADD ( dim_year[date], -1, YEAR ) )

// BLANK, never zero, when the base is missing. Zero would place an
// unmeasured branch in the middle of every ranking as though it had been
// measured. Refuse before computing.
Deposit CAGR 3yr =
VAR CurrentDeposits = [Total Deposits]
VAR BaseDeposits = CALCULATE ( [Total Deposits], DATEADD ( dim_year[date], -3, YEAR ) )
RETURN
    IF ( BaseDeposits > 0, ( CurrentDeposits / BaseDeposits ) ^ ( 1 / 3 ) - 1 )

// Endpoints come from the SELECTION, not hardcoded to 2019 and 2025, so
// the measure stays correct when a slicer narrows the range. A CAGR
// against a fixed endpoint under a filtered context keeps returning a
// plausible number, which is why it survives review.
Deposit CAGR % =
VAR CagrFirstYear = MIN ( dim_year[year] )
VAR CagrLastYear = MAX ( dim_year[year] )
VAR CagrYearSpan = CagrLastYear - CagrFirstYear
VAR CagrStartDeposits = CALCULATE ( [Total Deposits], dim_year[year] = CagrFirstYear )
VAR CagrEndDeposits = CALCULATE ( [Total Deposits], dim_year[year] = CagrLastYear )
RETURN
    IF (
        CagrYearSpan > 0
            && NOT ISBLANK ( CagrStartDeposits ) && CagrStartDeposits > 0
            && NOT ISBLANK ( CagrEndDeposits ),
        ( ( CagrEndDeposits / CagrStartDeposits ) ^ ( 1 / CagrYearSpan ) - 1 ) * 100
    )


// -------------------------------------------------------------------------
// Branch performance   [table: dim_branch]
// -------------------------------------------------------------------------

// THE DEFAULT ON EVERY VISUAL. The raw index fell mechanically as
// catchment size rose - median 1.518 in the smallest catchment quartile
// against 0.416 in the largest - and inverted the ranking of every
// market. Chicago read weakest at 0.564 and is strongest at 1.357 once
// adjusted.
Index (size-adjusted) =
AVERAGE ( dim_branch[index_size_adjusted] )

// Audit only, reachable through the page-2 field parameter so the
// market-position effect stays visible rather than normalised out of
// sight. Never rank on it.
Index (raw) =
AVERAGE ( dim_branch[index_raw] )

// No service-type filter is needed: SQL-08 already restricts to types 11
// and 12. Limited-service facilities structurally book no deposits, so a
// zero is a fact about the facility type rather than a measurement of
// it - left in, they score 0.0000 and sort to the top of any review list.
Underperforming Branches =
CALCULATE ( COUNTROWS ( dim_branch ), dim_branch[index_size_adjusted] < 1 )


// -------------------------------------------------------------------------
// Equity and the binding test   [table: lmi_coverage]
// -------------------------------------------------------------------------

LMI Coverage % =
CALCULATE ( MAX ( lmi_coverage[lmi_coverage_pct] ), ALL ( lmi_coverage ), lmi_coverage[rule] = "current" )

LMI Coverage % (recommended) =
CALCULATE ( MAX ( lmi_coverage[lmi_coverage_pct] ), ALL ( lmi_coverage ), lmi_coverage[rule] = "B_constrained" )

// THE BINDING TEST. Both deltas are non-negative by construction - a
// branch adds catchment area and removes none - so this compares their
// SIZES, not their signs. AC-06 as written (both values present) cannot
// fail; this can, and did, for the unconstrained commercial set, where
// non-LMI coverage grew 8.4x faster than LMI.
Coverage Delta Gap (pp) =
VAR SelectedRule = SELECTEDVALUE ( lmi_coverage[rule], "B_constrained" )
VAR CurrentLmiCoverage = CALCULATE ( MAX ( lmi_coverage[lmi_coverage_pct] ), ALL ( lmi_coverage ), lmi_coverage[rule] = "current" )
VAR CurrentNonLmiCoverage = CALCULATE ( MAX ( lmi_coverage[non_lmi_coverage_pct] ), ALL ( lmi_coverage ), lmi_coverage[rule] = "current" )
VAR RecommendedLmiCoverage = CALCULATE ( MAX ( lmi_coverage[lmi_coverage_pct] ), ALL ( lmi_coverage ), lmi_coverage[rule] = SelectedRule )
VAR RecommendedNonLmiCoverage = CALCULATE ( MAX ( lmi_coverage[non_lmi_coverage_pct] ), ALL ( lmi_coverage ), lmi_coverage[rule] = SelectedRule )
RETURN
    ( RecommendedLmiCoverage - CurrentLmiCoverage )
        - ( RecommendedNonLmiCoverage - CurrentNonLmiCoverage )

Binding Test Result =
IF (
    ISBLANK ( [Coverage Delta Gap (pp)] ),
    "NOT MEASURED",
    IF ( [Coverage Delta Gap (pp)] >= 0, "PASS - expansion is proportional", "FAIL - non-LMI coverage grows faster" )
)

Constraint Cost (index points) =
VAR CommercialScore = CALCULATE ( SUM ( recommendation_sets[opportunity_score] ), ALL ( recommendation_sets ), recommendation_sets[rule] = "A_commercial" )
VAR ConstrainedScore = CALCULATE ( SUM ( recommendation_sets[opportunity_score] ), ALL ( recommendation_sets ), recommendation_sets[rule] = "B_constrained" )
RETURN CommercialScore - ConstrainedScore

Constraint Cost % =
VAR CommercialScore = CALCULATE ( SUM ( recommendation_sets[opportunity_score] ), ALL ( recommendation_sets ), recommendation_sets[rule] = "A_commercial" )
RETURN DIVIDE ( [Constraint Cost (index points)], CommercialScore ) * 100

LMI Sites in Shortlist =
CALCULATE (
    COUNTROWS ( recommendation_sets ),
    recommendation_sets[lmi_flag] = TRUE,
    recommendation_sets[rule] = "B_constrained"
) + 0


// -------------------------------------------------------------------------
// Tract composition   [table: dim_tract]
// -------------------------------------------------------------------------

// SUBJECT-PREFIXED because in_catchment derives from
// bridge_branch_catchment, which covers the subject only - every measure
// reading it inherits that scope, and the field list should say so.
// Households, never tracts: the tract basis inflated the over-index from
// +1.9pp to +3.3pp. The 31 no-basis tracts leave BOTH numerator and
// denominator through the lmi_flag NULL, which is why neither filter
// coalesces it to FALSE.
Subject LMI Coverage =
DIVIDE (
    CALCULATE ( SUM ( dim_tract[households] ),
                dim_tract[lmi_flag] = TRUE, dim_tract[in_catchment] = TRUE ),
    CALCULATE ( SUM ( dim_tract[households] ), dim_tract[lmi_flag] = TRUE )
)

Subject Non-LMI Coverage =
DIVIDE (
    CALCULATE ( SUM ( dim_tract[households] ),
                dim_tract[lmi_flag] = FALSE, dim_tract[in_catchment] = TRUE ),
    CALCULATE ( SUM ( dim_tract[households] ), dim_tract[lmi_flag] = FALSE )
)

Subject Tract Coverage % =
DIVIDE (
    CALCULATE ( COUNTROWS ( dim_tract ), dim_tract[in_catchment] = TRUE ),
    COUNTROWS ( ALL ( dim_tract ) )
) * 100

// Tracts with no LMI determination leave BOTH numerator and denominator.
// Counting them as non-LMI would inflate the denominator and quietly
// improve every equity figure on the page.
LMI Share of Selection % =
VAR TractsDetermined = CALCULATE ( COUNTROWS ( dim_tract ), NOT ISBLANK ( dim_tract[lmi_flag] ) )
VAR TractsLmi = CALCULATE ( COUNTROWS ( dim_tract ), dim_tract[lmi_flag] = TRUE )
RETURN DIVIDE ( TractsLmi, TractsDetermined ) * 100

Cluster-Measured Growth % =
DIVIDE (
    CALCULATE ( COUNTROWS ( dim_tract ), dim_tract[growth_basis] <> "direct" ),
    CALCULATE ( COUNTROWS ( dim_tract ), NOT ISBLANK ( dim_tract[household_growth_pct] ) )
) * 100

Shortlist Caveat =
"LMI " & FORMAT ( [LMI Share of Selection %], "0.0" ) & "% vs 29.5% footprint  |  growth estimated for "
    & FORMAT ( [Cluster-Measured Growth %], "0.0" ) & "% of these tracts"


// -------------------------------------------------------------------------
// Capture rate   [table: tract_capture_rate]
// -------------------------------------------------------------------------

// Originations only, on BOTH sides of the ratio. Purchased loans
// (action_taken 6) were bought on the secondary market and say nothing
// about serving a tract; several lenders here exceed 88% purchased
// against the subject's 0.8%, so including them would inflate
// competitors far more than the subject.
Capture Rate % =
DIVIDE ( SUM ( tract_capture_rate[subject_originations] ), SUM ( tract_capture_rate[all_originations] ) ) * 100

Unmet Originations =
SUM ( tract_capture_rate[competitor_originations] )


// -------------------------------------------------------------------------
// Opportunity index   [table: opportunity_index]
// -------------------------------------------------------------------------

Published Opportunity Score =
AVERAGE ( opportunity_index[opportunity_score] )


// -------------------------------------------------------------------------
// What-if weighting   [table: index_components]
// -------------------------------------------------------------------------

Weight Total =
[w Household Growth Value] + [w Median Income Value] + [w Deposit Growth Value] + [w Competitor Saturation Value] + [w Unmet Demand Value]

// FR-03 demonstrated rather than claimed. Sliders cannot be constrained
// to sum to 1, so the measure normalises across whatever they do sum to
// rather than asking the user to do arithmetic. index_components ships
// wide precisely so this is a plain SUMX over five named columns.
// VAR names are long because `Weight` is RESERVED in DAX and will not
// parse - check_var_names() rejects a collision before writing.
Weighted Score =
VAR wHG = [w Household Growth Value]
VAR wMI = [w Median Income Value]
VAR wDG = [w Deposit Growth Value]
VAR wCS = [w Competitor Saturation Value]
VAR wUD = [w Unmet Demand Value]
VAR wTotal = wHG + wMI + wDG + wCS + wUD
RETURN
    IF (
        wTotal = 0,
        BLANK (),
        DIVIDE (
            SUMX (
                index_components,
                index_components[household_growth_z] * wHG
                    + index_components[median_income_z] * wMI
                    + index_components[deposit_growth_z] * wDG
                    + index_components[competitor_saturation_z] * wCS
                    + index_components[unmet_demand_z] * wUD
            ),
            wTotal
        )
    )

// The card beside the sliders. Moving unmet demand down visibly raises
// it, which is the sensitivity finding made interactive and the single
// most useful thing on the page.
Top 50 LMI Share % =
VAR Top50 =
    TOPN ( 50, ALL ( index_components ), [Weighted Score], DESC )
VAR Determined = COUNTROWS ( FILTER ( Top50, NOT ISBLANK ( index_components[lmi_flag] ) ) )
VAR IsLmi = COUNTROWS ( FILTER ( Top50, index_components[lmi_flag] = TRUE ) )
RETURN DIVIDE ( IsLmi, Determined ) * 100

Top 50 Cluster-Measured Growth % =
VAR Top50 =
    TOPN ( 50, ALL ( index_components ), [Weighted Score], DESC )
RETURN
    DIVIDE (
        COUNTROWS ( FILTER ( Top50, index_components[growth_is_estimated] = TRUE ) ),
        COUNTROWS ( Top50 )
    ) * 100

// What-if parameter: w Household Growth, 0 to 0.50 step 0.05, default 0.2
w Household Growth = GENERATESERIES ( 0, 0.5, 0.05 )
w Household Growth Value = SELECTEDVALUE ( 'w Household Growth'[w Household Growth], 0.2 )

// What-if parameter: w Median Income, 0 to 0.50 step 0.05, default 0.15
w Median Income = GENERATESERIES ( 0, 0.5, 0.05 )
w Median Income Value = SELECTEDVALUE ( 'w Median Income'[w Median Income], 0.15 )

// What-if parameter: w Deposit Growth, 0 to 0.50 step 0.05, default 0.25
w Deposit Growth = GENERATESERIES ( 0, 0.5, 0.05 )
w Deposit Growth Value = SELECTEDVALUE ( 'w Deposit Growth'[w Deposit Growth], 0.25 )

// What-if parameter: w Competitor Saturation, 0 to 0.50 step 0.05, default 0.2
w Competitor Saturation = GENERATESERIES ( 0, 0.5, 0.05 )
w Competitor Saturation Value = SELECTEDVALUE ( 'w Competitor Saturation'[w Competitor Saturation], 0.2 )

// What-if parameter: w Unmet Demand, 0 to 0.50 step 0.05, default 0.2
w Unmet Demand = GENERATESERIES ( 0, 0.5, 0.05 )
w Unmet Demand Value = SELECTEDVALUE ( 'w Unmet Demand'[w Unmet Demand], 0.2 )
