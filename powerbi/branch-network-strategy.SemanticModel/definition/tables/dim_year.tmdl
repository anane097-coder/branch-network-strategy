table dim_year
	lineageTag: 3b6f8b97-5e8a-547a-8c2c-0662c0a24a56

	column year
		dataType: int64
		lineageTag: a48b82f3-41c2-5891-bb73-49293223121e
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column sod_as_of_date
